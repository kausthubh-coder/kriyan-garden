{
  "expo": {
    "name": "Kriyan",
    "slug": "kriyan",
    "scheme": "kriyan",
    "version": "1.0.1",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "dark",
    "android": {
      "package": "app.kriyan.android",
      "versionCode": 3,
      "backgroundColor": "#110f0d"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110f0d",
          "image": "./assets/icons/foreground.png"
        }
      ],
      "@clerk/expo",
      "@clerk/expo-google-signin",
      "expo-quick-actions",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c332d90-6af8-4ea6-8c10-4ee8e0e93562"
      }
    },
    "owner": "kausthubh",
    "backgroundColor": "#110f0d"
  }
}
