NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
SERVICE_SECRET=

# Playwright uses only a Clerk development instance and a disposable test user.
# @clerk/testing obtains CLERK_TESTING_TOKEN automatically from the test keys.
CLERK_PUBLISHABLE_KEY=
CLERK_TESTING_TOKEN=
# Optional existing dedicated test user; otherwise setup creates one per run.
E2E_CLERK_USER_EMAIL=
# Optional existing prototype-fixture test user for screenshot captures.
E2E_SCREENSHOT_USER_EMAIL=
E2E_BASE_URL=http://localhost:3000
