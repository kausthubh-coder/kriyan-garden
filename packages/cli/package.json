{
  "name": "kriyan",
  "version": "0.1.0",
  "description": "Plan tasks and goals in School, Business and Life from your terminal.",
  "license": "MIT",
  "type": "module",
  "bin": { "kriyan": "dist/kriyan.js" },
  "files": ["dist/kriyan.js", "README.md"],
  "engines": { "node": ">=22.18.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tsdown.config.ts",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "optionalDependencies": { "@napi-rs/keyring": "2.1.0" },
  "devDependencies": {
    "@kriyan/core": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "tsdown": "0.23.0",
    "typescript": "^5"
  }
}
