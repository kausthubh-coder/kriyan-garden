{
  "name": "kriyan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @kriyan/web dev",
    "build": "bun run --filter @kriyan/web build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter @kriyan/web typegen && bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "ignoreScripts": ["sharp", "unrs-resolver"],
  "trustedDependencies": ["esbuild", "sharp", "unrs-resolver"]
}
